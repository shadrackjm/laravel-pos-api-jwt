meta {
  name: 06 List Products
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/products?search=&sort=name&direction=asc&per_page=15
  body: none
  auth: bearer
}

params:query {
  search:
  sort: name
  direction: asc
  per_page: 15
  ~category_id: 1
  ~in_stock: 1
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("paginated envelope", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.meta.per_page).to.equal(15);
  });
}

docs {
  Episode 21. The `~` prefixed params are disabled by default — toggle them on
  camera to demonstrate combining filters.

  Try `sort=id` to show the whitelist rejecting it with a 422, and
  `per_page=1000000` to show the cap.

  Run this before and after "07 Create Sale" to show the stock drop.
}
