meta {
  name: 13 No token (401)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/products
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("401, and in our envelope", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.body.success).to.equal(false);
    expect(res.body.message).to.be.a("string");
  });
}

docs {
  Episode 11. Deliberately sends no Authorization header.

  Note the response uses OUR envelope (episode 7), not Laravel's default —
  errors are as consistent as successes.

  Also try pasting a token and changing one character: still 401, because the
  signature no longer matches.
}
